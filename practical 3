# if statement

num = 10

if num > 0:
    print("Number is positive")
    
# if-else Statement
# Program to check whether a number is even or odd

num = 7

if num % 2 == 0:
    print("Number is Even")
else:
    print("Number is Odd")
    
# elif Statement
# Program to find grade using elif

marks = 75

if marks >= 90:
    print("Grade A+")
elif marks >= 80:
    print("Grade A")
elif marks >= 70:
    print("Grade B")
elif marks >= 60:
    print("Grade C")
else:
    print("Grade D")

# while Loop
# Print numbers from 1 to 5 using while loop
i = 1


while i <= 5:
    print(i)
    i += 1

# for Loop
# Print numbers from 1 to 5 using for loop


for i in range(1, 6):
    print(i)
    
 # Nested Loops
# Program to demonstrate nested for loop
for i in range(1, 4):
    for j in range(1, 4):
        print(i, j)

# break Statement
# Stop the loop when number becomes 5


for i in range(1, 11):
    if i == 5:
        break
    print(i)

# continue Statement
# Skip number 5
for i in range(1, 11):
    if i == 5:
        continue
    print(i)
    
# pass Statement
# Demonstrate pass statement
for i in range(1, 6):
    if i == 3:
        pass
    print(i)

    
