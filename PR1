# 8. List
# ------------------------------------------

marks = [78, 85, 90, 88, 95]

print("\nOriginal List")
print(marks)

marks.append(80)
marks.insert(2, 100)

print("Updated List")
print(marks)

print("Maximum =", max(marks))
print("Minimum =", min(marks))
print("Sum =", sum(marks))
print("Average =", sum(marks)/len(marks))

